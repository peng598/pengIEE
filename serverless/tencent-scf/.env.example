# Example only. Configure real secrets in the SCF console; do not commit them.
SUBMISSIONS_ENABLED=true
AUTH_SECRET=
ALLOWED_ORIGINS=https://peng598.github.io
DB_HOST=
DB_PORT=3306
DB_USER=pengiee_app
DB_PASSWORD=
DB_NAME=pengiee
# Optional PEM certificate from TencentDB, with escaped newlines, to verify MySQL TLS.
# Without this, use only the VPC private endpoint; never open MySQL to the internet.
DB_TLS_CA=
COS_BUCKET=
COS_REGION=ap-guangzhou
MAX_UPLOAD_BYTES=4194304
MAX_USER_STORAGE_BYTES=104857600
MAX_USER_FILES=100
SESSION_HOURS=12
# TENCENTCLOUD_SECRETID / TENCENTCLOUD_SECRETKEY / TENCENTCLOUD_SESSIONTOKEN
# must come from the SCF execution role, not the web page or a root API key.
